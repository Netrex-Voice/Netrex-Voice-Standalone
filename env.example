# Firebase Configuration
# Firebase Console'dan (https://console.firebase.google.com) projenizin ayarlarından alın
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# LiveKit Configuration
# LiveKit Cloud veya kendi LiveKit sunucunuzdan alın
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server-url



# Netrex Games — P2P için isteğe bağlı TURN (simetrik NAT'lerde doğrudan bağlantı kurulamazsa)
# Boşsa yalnızca Google STUN kullanılır; P2P kurulamayan oyuncular otomatik olarak LiveKit üzerinden oynar.
# NEXT_PUBLIC_GAMES_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_GAMES_TURN_USER=
# NEXT_PUBLIC_GAMES_TURN_CRED=
