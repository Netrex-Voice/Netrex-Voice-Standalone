{
  "name": "netrex",
  "version": "0.0.1",
  "description": "Secure Desktop Voice Chat Application",
  "homepage": "./",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:web": "cross-env NEXT_PUBLIC_BUILD_TARGET=web next dev",
    "build": "next build",
    "build:web": "cross-env NEXT_PUBLIC_BUILD_TARGET=web next build",
    "start:web": "next start",
    "postbuild": "node scripts/fix-electron-paths.js",
    "preelectron-pack": "node scripts/copy-env.js",
    "start": "next start",
    "lint": "next lint",
    "test:games": "node --test src/modules/games/__tests__/*.test.js",
    "electron-dev": "node scripts/copy-env.js && concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.netrex.app",
    "productName": "Netrex",
    "compression": "maximum",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Netrex-Voice",
        "repo": "Netrex_Voice_App",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "public/logo.ico",
        "to": "logo.ico"
      },
      {
        "from": "public/logo.png",
        "to": "logo.png"
      },
      {
        "from": "public/rnnoise-suppressor.worklet.js",
        "to": "rnnoise-suppressor.worklet.js"
      },
      {
        "from": "public/voice-processor.worklet.js",
        "to": "voice-processor.worklet.js"
      }
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Netrex, sesli sohbet için mikrofonunuza ihtiyaç duyar.",
        "NSCameraUsageDescription": "Netrex, görüntülü sohbet için kameranıza ihtiyaç duyar.",
        "NSScreenCaptureUsageDescription": "Netrex, ekran paylaşımı için ekran kaydı iznine ihtiyaç duyar.",
        "NSAccessibilityUsageDescription": "Netrex, global klavye kısayolları (bas-konuş) için erişilebilirlik iznine ihtiyaç duyar."
      }
    }
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@timephy/rnnoise-wasm": "^1.0.0",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "immer": "^11.1.3",
    "livekit-server-sdk": "^2.14.2",
    "three": "^0.186.1",
    "uiohook-napi": "^1.1.0"
  },
  "devDependencies": {
    "@livekit/components-react": "^2.9.16",
    "@livekit/components-styles": "^1.2.0",
    "@livekit/track-processors": "^0.6.1",
    "autoprefixer": "^10.0.1",
    "baseline-browser-mapping": "^2.9.18",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.8.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "39.2.3",
    "electron-builder": "^26.0.12",
    "emoji-picker-react": "^4.16.1",
    "firebase": "^11.0.2",
    "framer-motion": "^12.23.26",
    "livekit-client": "^2.16.0",
    "lucide-react": "^0.563.0",
    "next": "^14.2.16",
    "postcss": "^8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-textarea-autosize": "^8.5.9",
    "react-virtuoso": "^4.18.1",
    "react-window": "^2.2.5",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.3.0",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.7"
  }
}
